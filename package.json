{
  "name": "kana-quest",
  "version": "0.1.0",
  "private": true,
  "description": "A Japanese learning game: hiragana, katakana, then JLPT N5 to N1, with spaced repetition.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:fetch": "python -I tools/fetch_data.py",
    "data:build": "python -I tools/build_data.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "idb-keyval": "^6.3.0",
    "preact": "^11.0.2",
    "ts-fsrs": "^5.4.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
